# Local preview is the default. Keep demo until real products are ready.
COMMERCE_MODE=demo

# Your WordPress root address (not /wp-admin or /wp-json).
WORDPRESS_URL=https://fayshop.de5.net

# Update to the public frontend domain when deploying.
SITE_URL=http://localhost:3000

# Configure a real monitored address before launch.
SUPPORT_EMAIL=

# Install wordpress/pawmade-checkout and configure the same secret in wp-config.php.
# Generate a random value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never prefix a secret variable with NEXT_PUBLIC_.
WOOCOMMERCE_BRIDGE_SECRET=

# Enable only after real products, reviewed policies and payment tests are complete.
CHECKOUT_ENABLED=false
ALLOW_INDEXING=false
